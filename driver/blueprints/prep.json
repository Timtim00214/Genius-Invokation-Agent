      "params": {
        "system": "你是七圣召唤（Genius Invokation TCG）教练，擅长把一副牌组的特点写成简洁、可执行的战术。",
        "task": "上面是牌组资料；若还附了教练给的初始战术，就把它和牌组特点合起来，写成这局可执行的赛前计划：核心打法、起手留牌、关键连招、元素调和与充能节奏。不超过 600 字，直接给正文，不要客套。没有教练战术时就按牌组特点自己定。",
        "budget_chars": 3000,
        "role": "user",
        "include_system": true
      },
      "accent": "#0ea5e9"
    },
    {
      "id": "llm",
      "type": "llm_chat",
      "label": "写战术",
      "position": {
        "x": 900,
