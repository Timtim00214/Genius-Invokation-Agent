# 七圣召唤 AI 司机 · 本地配置模板
#
# 用法：把这个文件复制成同目录下的 `.env`，填上你自己的密钥。
#       `driver/.env` 是本地私密文件，不要提交、不要发给别人。
# 规则：一行一个 `KEY=VALUE`，`#` 开头是注释，值两边可以带引号；
#       系统里已经存在的同名环境变量优先（方便临时覆盖）。
# 读取：driver/lib/secrets.mjs 在司机 / replay 启动时读入。
#
# 三个座位相关的事实：
#   * PvE（你打 AI）：只有座位 1 是 AI，填一份就行。
#   * EvE（AI 打 AI）：两个座位各一个司机进程，靠 SEAT0_ / SEAT1_ 前缀分开。
#   * 不带座位前缀的 LLM_* 是两个座位共用的默认值。

# ---------------------------------------------------------------- 密钥
# 司机会按蓝图里 llm_chat 节点的 api_base 自动挑对应变量补 api_key。
# 想用别的厂商 / 自建兼容端点，随便起个名字，再用 *_API_KEY_ENV 指过去。
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# MY_PROXY_API_KEY=

# ---------------------------------------------------------------- 座位 0（先手）
SEAT0_LLM_MODEL=
SEAT0_LLM_API_BASE=
SEAT0_LLM_API_KEY_ENV=
SEAT0_LLM_MAX_TOKENS=
SEAT0_LLM_TIMEOUT_SECONDS=

# ---------------------------------------------------------------- 座位 1（后手）
SEAT1_LLM_MODEL=
SEAT1_LLM_API_BASE=
SEAT1_LLM_API_KEY_ENV=
SEAT1_LLM_MAX_TOKENS=
SEAT1_LLM_TIMEOUT_SECONDS=

# ---------------------------------------------------------------- 两个座位共用的默认值
LLM_MODEL=
LLM_API_BASE=
LLM_API_KEY_ENV=
LLM_MAX_TOKENS=
LLM_TIMEOUT_SECONDS=

# 常用取值参考
#   DeepSeek 官方：  LLM_MODEL=deepseek-flash        LLM_API_BASE=https://api.deepseek.com/v1
#   OpenAI 官方：    LLM_MODEL=gpt-4o                LLM_API_BASE=https://api.openai.com/v1
#   OpenRouter：     LLM_MODEL=deepseek/deepseek-chat LLM_API_BASE=https://openrouter.ai/api/v1
#   本地 Ollama：    LLM_MODEL=qwen2.5:14b           LLM_API_BASE=http://127.0.0.1:11434/v1
#   思考型模型慢，max_tokens 建议 16384（约 60s/手）或 32768（更慢）；
#   timeout_seconds 上限 600，桥接自己也 600s 封顶。
